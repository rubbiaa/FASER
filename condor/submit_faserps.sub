universe   = vanilla

# Normally you don't call condor_submit on this file yourself: submit_jobs.sh
# (run on lxplus, or via submit_from_mac.sh) fills in the per-run variables
# below with -append and builds the job list. The values here are only
# placeholders so the file is self-documenting.
homefaser = /afs/cern.ch/work/r/rubbiaa/FASER
shared    = /eos/user/r/rubbiaa/FASERDATA
inputroot = none
seed0     = 123456789
extra     =
jobslist  = jobs.list

Executable = faserps_chunk.sh
Arguments  = "$(homefaser) $(shared) $(inputroot) $(start) $(nevt) $(chunk) $(seed0) $(extra)"

# Condor does not create the log directory; submit_jobs.sh does.
Log        = logs/faserps_$(ClusterId).$(chunk).log
Output     = logs/faserps_$(ClusterId).$(chunk).out
Error      = logs/faserps_$(ClusterId).$(chunk).err

getenv = False

request_cpus   = 1
request_memory = 8 GB
request_disk   = 10 GB

# Runtime at CERN is controlled by flavour
+JobFlavour = "tomorrow"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

queue chunk, start, nevt from $(jobslist)
